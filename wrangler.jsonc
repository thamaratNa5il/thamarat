{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thamarat",
  "compatibility_date": "2026-09-01",
  // الـ worker بيشتغل بس على /api/* (مساعد الشات)، وباقي الموقع ملفات ثابتة زي ما هو
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
